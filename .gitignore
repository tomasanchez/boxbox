# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
dist/
build/
*.egg-info/

# Node
node_modules/
.pnpm-store/
apps/web/dist/
*.tsbuildinfo

# Environment — never commit secrets
.env
.env.*
!.env.example

# Data: FastF1 cache and generated datasets. These are large, re-derivable and
# must never enter git.
# Se ignora el CONTENIDO y no el directorio: git no desciende a un directorio
# excluido, así que con `apps/ml/data/` la excepción de abajo nunca se evalúa.
apps/ml/data/*
*.parquet
*.feather

# Excepción: las predicciones congeladas ANTES de una carrera. Son chicas, no son
# re-derivables — el punto es justamente que existieran antes del resultado — y
# sin ellas versionadas la afirmación "esto se escribió antes" no es verificable.
!apps/ml/data/*_prediccion.json

# Notebook checkpoints
.ipynb_checkpoints/

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
